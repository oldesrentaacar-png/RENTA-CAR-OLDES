<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only: cleartext (HTTP) is blocked system-wide via usesCleartextTraffic=false -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
