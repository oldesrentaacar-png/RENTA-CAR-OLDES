# ── App URLs ──────────────────────────────────────────────
# Admin (preferido): https://app.oldesrentacar.com
NEXT_PUBLIC_APP_URL=
# Landing (preferido): https://oldesrentacar.com
NEXT_PUBLIC_LANDING_URL=

# ── Supabase (cerebro de datos + Auth + RLS) ──────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (fotos públicas de vehículos) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cloudflare R2 (archivos privados) ─────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Opcional: dominio custom del bucket (no público por defecto)
R2_PUBLIC_BASE_URL=

# Database password (Project Settings → Database) — migraciones
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Primer administrador (solo local / scripts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ── Resend (correo opcional) ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Seguridad API pública ─────────────────────────────────
# Origen(es) de la Landing, separados por coma
# ej. https://oldesrentacar.com,http://localhost:5500
LANDING_ALLOWED_ORIGIN=
